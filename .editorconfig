root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[data/*.csv]
# Sample data is provided by the instructor; keep it byte-for-byte.
trim_trailing_whitespace = false
insert_final_newline = false
